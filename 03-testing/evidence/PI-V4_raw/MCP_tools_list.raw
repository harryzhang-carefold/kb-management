event: message
data: {"jsonrpc":"2.0","id":1,"result":{"tools":[{"description":"列出所有知识库。\n\n返回知识库列表，包含 id、名称、描述、文档数、分块数等信息。\n可通过 keyword 按名称模糊搜索。\n","inputSchema":{"properties":{"keyword":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Keyword"}},"type":"object","title":"list_knowledge_basesArguments"},"name":"list_knowledge_bases","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"type":"object","title":"list_knowledge_basesOutput"}},{"description":"获取指定知识库的详细信息，包括成员列表、文档统计、分块统计。\n\n参数:\n  kb_id: 知识库 UUID（与 name 二选一）\n  name:  知识库名称（精确匹配，与 kb_id 二选一）\n","inputSchema":{"properties":{"kb_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Kb Id"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Name"}},"type":"object","title":"get_kb_detailsArguments"},"name":"get_kb_details","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"type":"object","title":"get_kb_detailsOutput"}},{"description":"在知识库中执行混合检索（向量 kNN + BM25 全文 + RRF 融合）。\n\n参数:\n  query:  搜索查询（自然语言或关键词）\n  kb_id:  知识库 UUID（与 name 二选一，不传则搜索所有知识库）\n  name:   知识库名称（与 kb_id 二选一）\n  mode:   检索模式: hybrid(混合) / vector(纯向量) / keyword(纯关键词)，默认 hybrid\n  top_k:  返回结果数量，默认 5（上限 100），避免工具输出过大触发 agent 截断\n\n返回: 命中的文档片段列表，包含 filename、chunk_index、content、score、match_type。\n","inputSchema":{"properties":{"query":{"title":"Query","type":"string"},"kb_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Kb Id"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"mode":{"default":"hybrid","title":"Mode","type":"string"},"top_k":{"default":5,"title":"Top K","type":"integer"}},"required":["query"],"type":"object","title":"search_knowledgeArguments"},"name":"search_knowledge","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"type":"object","title":"search_knowledgeOutput"}},{"description":"基于知识库的 RAG 问答：混合检索相关片段 + LLM 生成带引用的回答。\n\n参数:\n  question: 用户问题（自然语言）\n  kb_id:    知识库 UUID（与 name 二选一，不传则搜索所有知识库）\n  name:     知识库名称（与 kb_id 二选一）\n  top_n:    引用片段数量，默认 5\n\n返回: LLM 生成的完整回答（Markdown 格式）+ sources 来源引用列表。\n","inputSchema":{"properties":{"question":{"title":"Question","type":"string"},"kb_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Kb Id"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"top_n":{"default":5,"title":"Top N","type":"integer"}},"required":["question"],"type":"object","title":"rag_queryArguments"},"name":"rag_query","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"type":"object","title":"rag_queryOutput"}},{"description":"列出指定知识库中的所有文档及其处理状态。\n\n参数:\n  kb_id:  知识库 UUID（与 name 二选一）\n  name:   知识库名称（与 kb_id 二选一）\n  status: 文档状态过滤: uploaded/parsing/parsed/chunking/embedding/indexed/failed\n","inputSchema":{"properties":{"kb_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Kb Id"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Name"},"status":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Status"}},"type":"object","title":"list_documentsArguments"},"name":"list_documents","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"type":"object","title":"list_documentsOutput"}},{"description":"查看指定文档的分块列表。\n\n参数:\n  document_id: 文档 UUID\n  page:        页码，默认 1\n  page_size:   每页数量，默认 20\n","inputSchema":{"properties":{"document_id":{"title":"Document Id","type":"string"},"page":{"default":1,"title":"Page","type":"integer"},"page_size":{"default":20,"title":"Page Size","type":"integer"}},"required":["document_id"],"type":"object","title":"get_document_chunksArguments"},"name":"get_document_chunks","outputSchema":{"properties":{"result":{"title":"Result","type":"string"}},"required":["result"],"type":"object","title":"get_document_chunksOutput"}}]}}

