# ============================================================
# kb-management — 环境变量模板
# 复制为 .env 并填入真实值
# ============================================================

# ---------- 应用 ----------
APP_NAME=kb-management
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://34.85.104.227/kb-management

# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=9011
PG_USER=kb_admin
PG_PASSWORD=kb_pas…2026
PG_DB=kb_management
DATABASE_URL=postgresql+psycopg2://kb_admin:kb_password_2026@localhost:9011/kb_management

# ---------- Elasticsearch ----------
ES_HOST=http://localhost:9200
ES_INDEX=kb_chunks
ES_EMBEDDING_DIM=3584

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=kb_admin
MINIO_SECRET_KEY=kb_mi…2026
MINIO_BUCKET=kb-docs
MINIO_SECURE=false

# ---------- Redis (Celery broker / result backend) ----------
# 复用现有 redis 容器
REDIS_HOST=localhost
REDIS_PORT=6179
REDIS_PASSWORD=
CELERY_BROKER_URL=redis://localhost:6179/0
CELERY_RESULT_BACKEND=redis://localhost:6179/1

# ---------- Embedding API (OpenAI 兼容) ----------
# 注意：代码读取 EMBEDDING_BASE_URL（pydantic 字段 embedding_base_url）；
# 旧变量名 EMBEDDING_API_BASE 不被读取（曾导致端点恒用代码默认值）
EMBEDDING_BASE_URL=http://127.0.0.1:8100/v1
EMBEDDING_API_BASE=http://127.0.0.1:8100/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gte-qwen2
EMBEDDING_DIM=3584
EMBEDDING_TIMEOUT=60

# ---------- LLM API (OpenAI 兼容) ----------
# 注意：代码读取 LLM_BASE_URL（pydantic 字段 llm_base_url）；
# 旧变量名 LLM_API_BASE 不被读取（曾导致端点恒用代码默认值，与 EMBEDDING_API_BASE 同类陷阱）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_BASE=https://api.deepseek.com/v1
# 真实密钥只进 infra/.env（.gitignore 覆盖），此处仅占位；切勿把真实 key 提交进 git
LLM_API_KEY=sk-replace-with-real-key
LLM_MODEL=deepseek-flash
# PageIndex 建树/检索推理专用模型（复用 LLM_BASE_URL / LLM_API_KEY）
PAGEINDEX_LLM_MODEL=deepseek-flash
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ---------- 文档处理 ----------
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_BATCH_SIZE=32

# ---------- MinerU 文档解析服务（本地 CPU，docker-compose 的 mineru 服务）----------
MINERU_API_URL=http://127.0.0.1:9030
MINERU_BACKEND=pipeline
MINERU_LANG=ch
MINERU_TIMEOUT_SECONDS=1800

# ---------- 按类型文件大小上限（MB）----------
MAX_SIZE_PDF_MB=15
MAX_SIZE_OFFICE_MB=20
MAX_SIZE_IMAGE_MB=20
MAX_SIZE_TEXT_MB=10

# ---------- 知识库引用（kb citations, V2）----------
# MCP 9100 Bearer 密钥（真实值只进 .env，不进 git）
KB_MCP_API_KEY=change…-key
# doc_url 绝对 URL 基址（公网入口，含 /kb-management 前缀）
KB_PUBLIC_BASE_URL=https://agent.carefold.ai/kb-management
# 文档只读 view_token 有效期（分钟）
KB_VIEW_TOKEN_MINUTES=15

# ---------- 种子账号 ----------
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@kb.local
SEED_ADMIN_PASSWORD=***
