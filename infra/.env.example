# ---------- 应用 ----------
APP_NAME=kb-management
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://34.85.104.227/kb-management

# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=9011
PG_USER=kb_admin
PG_PASSWORD=kb_pas…2026
PG_DB=kb_management
DATABASE_URL=postgresql+psycopg2://kb_admin:kb_password_2026@localhost:9011/kb_management

# ---------- Elasticsearch ----------
ES_HOST=http://localhost:9200
ES_INDEX=kb_chunks
ES_EMBEDDING_DIM=3584

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9002
MINIO_ACCESS_KEY=kb_admin
MINIO_SECRET_KEY=kb_mi…2026
MINIO_BUCKET=kb-docs
MINIO_SECURE=false

# ---------- Redis (Celery broker / result backend) ----------
